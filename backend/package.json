    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "playwright": "1.63.0",
    "stripe": "^17.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
