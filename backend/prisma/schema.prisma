generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  subscriptionStatus   String? // active / past_due / canceled / null(未加入)

  // 管理者フラグ。/auth/register からは絶対に設定できず、DBを直接操作した場合のみtrueになる。
  // 課金ゲートを素通りできる（テスト用・実際の支払いなしで全機能を確認するため）
  isAdmin Boolean @default(false)

  // スマホアプリのプッシュ通知先（Expo Push Token）。通知オフ・アプリ削除時はnull
  expoPushToken String?

  // trueにすると、AIコンプライアンス担当の審査に通ったSNS投稿下書きを、人間の承認なしで自動的に投稿予約する。
  // 既定はfalse（本人がダッシュボードで明示的にオンにするまで有効にならない）
  autoPublishEnabled Boolean @default(false)

  landingPages        LandingPage[]
  lineConfig          LineConfig?
  socialAccounts      SocialAccount[]
  scheduledPosts      ScheduledPost[]
  agentTasks          AgentTask[]
  automationWorkflows AutomationWorkflow[]
}

// 「どのサイトで、どの操作をするか」を編集できるブラウザ操作の自動化ワークフロー。
// パスワード・カード番号・CVV等を入力する手順は保存・実行のどちらの時点でも拒否する
// （backend/src/automation/safety.ts）。定型的な繰り返し作業（情報収集・フォーム入力の下書きなど）向け。
model AutomationWorkflow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  targetUrl   String
  // [{ action: 'navigate'|'click'|'type'|'select'|'waitFor'|'extract', selector?, value?, label? }, ...]
  steps       Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs AutomationRun[]

  @@index([userId])
}

model AutomationRun {
  id           String             @id @default(cuid())
  workflowId   String
  workflow     AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status       String             @default("running") // running / success / failed / blocked
  // 各手順の実行結果、ブロックされた場合はその理由を記録する
  log          Json?
  blockedStep  Int?
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?

  @@index([workflowId, startedAt])
}

// 役割ごとのAIエージェント（マーケティング担当・成長分析担当など）が定期実行で作った成果物。
// 「作成・分析」は自動で行うが、実際にSNS投稿するなど外部に影響する実行は、
// コンプライアンス担当エージェントの審査を経たうえで、人間の承認（approve）または
// 本人が有効にしたautoPublishEnabledによる自動承認のいずれかを経てから行う
model AgentTask {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      String    // marketing / growth / compliance
  kind      String    // sns_post_draft / lp_health_check
  lpId      String?
  output    Json      // エージェントが作った内容（下書き文章・分析結果など）
  status    String    @default("pending_review") // pending_review / approved / rejected
  // コンプライアンス担当エージェントの審査結果（sns_post_draftのみ）
  reviewPassed Boolean?
  reviewNote   String?
  autoApproved Boolean  @default(false) // trueなら人間の承認を経ず自動で承認・投稿予約された
  createdAt DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId, status])
}

// X / Instagram / YouTube / TikTok の連携。OAuthのアクセストークンを保管する。
// トークンは平文保存（LineConfigと同様、暗号化はフェーズ2で対応）
model SocialAccount {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  platform      String    // x / instagram / youtube / tiktok
  accountLabel  String?   // 表示用（アカウント名・チャンネル名など）
  externalId    String?   // プラットフォーム側のアカウントID
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  connectedAt   DateTime  @default(now())

  @@unique([userId, platform])
}

// 複数プラットフォーム同時投稿の予約。Redis不要のDBポーリング方式（backend/src/social/scheduler.ts）で実行する
model ScheduledPost {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  text        String
  mediaUrl    String?
  platforms   String[] // 例: ["x","instagram"]
  scheduledAt DateTime
  status      String   @default("pending") // pending / processing / done / failed
  attempts    Int      @default(0)
  results     Json?    // { x: {ok:true, postId}, instagram: {ok:false, error} } 形式
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, scheduledAt])
}

model LandingPage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  slug           String   @unique
  businessName   String
  heroTitle      String
  strengths      String[]
  socialProof    String?
  scarcityOffer  String?
  pageViews      Int      @default(0)
  createdAt      DateTime @default(now())

  // lp = 1ページで完結（申し込み・予約への行動に集中）
  // hp = 複数ページ（ホーム＋機能ごとに専用ページ＋ナビゲーション）
  siteType String @default("lp")
  // business = お店・ビジネス / creator = クリエイター活動（音楽・イラスト・写真・動画など）。文言とAIの書き方が変わる
  purpose String @default("business")
  // 持ち主のLINE公式アカウントの友だち追加URL（https://lin.ee/... など）。未登録ならLINEボタンを出さない
  lineAddUrl String?
  // ユーザーが完成例から選んだ土台デザイン（PRESET_METAのid）。未選択ならnull
  templateKey String?

  // 独自ドメイン（例: www.example.jp）。DNSのCNAME確認が取れたらverified=true
  customDomain         String?  @unique
  customDomainVerified Boolean  @default(false)

  // AIが作成したデザイン（配色・書体・レイアウト）。nullなら業種に合うプリセットを使う
  design          Json?
  designSource    String?   // ai / preset
  designStatus    String?   // generating / ready
  designUpdatedAt DateTime?
  // Geminiが生成したメイン画像（JPEG）。どの公開先でも消えないようDBに保存する
  heroImage       Bytes?
  heroImageType   String?

  // 追加した機能（セクション）。[{ feature, content, inputs, promptBy, updatedAt }]
  // inputs は店主の回答（編集用）で、公開ページには出さない
  sections Json?

  photos   Photo[]
  variants LpVariant[]
  tools    LpTool[]
}

// ---- 外部ツール（収益の柱: 運営者のアフィリエイトリンク経由でユーザーが導入する） ----
// 運営者（管理者）が管理画面で登録するツールのカタログ。affiliateUrl はASPで発行された成果測定リンク。
// allowedHosts は、ユーザーが自分のサイトに貼れるURLのホスト（例: airrsv.net）。これ以外のURLは貼らせない
// （任意のURLやHTMLを許すと、AWPドメイン上で第三者のスクリプトが動き、他ユーザーの情報を盗めてしまうため）
model ToolCatalogItem {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  category     String
  description  String
  officialUrl  String
  affiliateUrl String?
  allowedHosts String[]
  // button = ボタンでツールの画面へ移動 / embed = ページ内に埋め込み表示（iframe）も許可
  embeddable   Boolean  @default(false)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ユーザーが自分のサイトに追加したツール。保存するのは公開用のURLだけで、
// ツールのログイン情報や顧客データはAWPに保存しない（ユーザー本人のツールのアカウント側に残る）
model LpTool {
  id        String      @id @default(cuid())
  lpId      String
  lp        LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  toolKey   String
  label     String
  url       String
  display   String      @default("button") // button / embed
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([lpId])
}

// アフィリエイトリンクのクリック計測（どのツールが選ばれているかを把握し、カタログ改善に使う）。
// 個人を特定する情報は保存しない
model AffiliateClick {
  id        String   @id @default(cuid())
  toolKey   String
  source    String?
  createdAt DateTime @default(now())

  @@index([toolKey])
}

// A/Bテスト用のヒーローコピーのバリエーション。最初の1件を作成した時点で、
// それまでのheroTitleをisControl=trueの行として複製し、以後は登録した行の中から
// 均等な確率で1つを選んで表示する（backend/src/routes/lp.ts の pickVariant）。
// 表示（impressions）・LINE友だち追加への遷移（conversions）を数え、
// 成長分析担当エージェントが十分な件数が集まった時点で優劣を判定する（backend/src/agents/growth.ts）
model LpVariant {
  id          String      @id @default(cuid())
  lpId        String
  lp          LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  label       String
  heroTitle   String
  isControl   Boolean     @default(false)
  enabled     Boolean     @default(true)
  impressions Int         @default(0)
  conversions Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([lpId])
}

// 監視担当エージェントが診断する、想定外のエラーの記録（backend/src/lib/errors.ts で記録、
// backend/src/agents/monitoring.ts でClaudeが原因分析・修正案の提示を行う）。
// 修正コードの自動適用や本番へのロールバックは行わない（human on the loopの原則）。
model SystemError {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  context   Json?
  diagnosis String?
  status    String   @default("open") // open / diagnosed / resolved
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// 店主がアップロードした実物の写真とロゴ。Geminiで補正した版（enhanced）はClaudeの審査に通った場合だけ使う
model Photo {
  id            String      @id @default(cuid())
  lpId          String
  lp            LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  isLogo        Boolean     @default(false)
  position      Int         @default(0)
  original      Bytes
  originalType  String
  enhanced      Bytes?
  enhancedType  String?
  enhanceStatus String?     // done / rejected / failed / null(未処理)
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@index([lpId])
}

// channelSecret / channelAccessToken はアプリ層で暗号化してから保存すること
// (フェーズ2で対応。平文保存のままでは他事業者のLINEアカウントの乗っ取りに直結する)
model LineConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  // 無料お試し中はLINEをまだ持っていない顧客もいるため、作成時点では未入力を許可する
  channelId          String?
  channelSecret      String?
  channelAccessToken String?
  // Webhookの自動登録（setupLineWebhook）を既に実行済みか。有料プラン加入時に一度だけ実行する
  webhookActivated   Boolean  @default(false)
  friendsAdded       Int      @default(0)
  createdAt          DateTime @default(now())
}

// AWP自体の見た目（マーケティングLP・ウィザードなどの装飾画像）。
// 顧客のLPとは無関係。管理者が管理画面からAIで生成・差し替えできる（キー単位で1枚だけ保持）
model SiteAsset {
  key       String   @id
  image     Bytes
  mimeType  String
  prompt    String
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  tenantId  String
  senderName String
  message   String
  source    String
  createdAt DateTime @default(now())

  @@index([tenantId])
}
