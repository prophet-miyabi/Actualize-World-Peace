generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  // SMS認証済みの携帯番号（E.164形式: +8190...）。1つの番号で作れるアカウントは1つ（捨てアカウント対策）。
  // パスワード再設定のコード送信先にもなる
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  // ログイン用トークンの世代。パスワード再設定で1つ進め、それより前に発行したトークンをすべて無効にする
  tokenVersion    Int       @default(0)

  // ---- プロフィール（SNS） ----
  // ユーザー名は公開URL（/ユーザー名）になる。ページのURL（LandingPage.slug）と同じ名前空間なので、相互に重複させない
  username String?  @unique
  bio      String?
  category String?  // business / creator / other
  region   String?  // 地域検索用（都道府県など、本人が入力したもの）
  links    Json?    // [{ label, url }] 本人のSNS・外部サイト
  // 通報などで運営者が非公開にしたプロフィール
  profileHidden Boolean @default(false)
  following Follow[] @relation("following")
  followers Follow[] @relation("followers")
  pageLikes PageLike[]
  builderSessions BuilderSession[]
  posts Post[]
  harnessLinks HarnessLink[]
  harnessPosts HarnessScheduledPost[]

  // AWPの有料プラン（自前の請求: 銀行振込・キャッシュ）。planUntil を過ぎると無料プランに戻る
  plan      String    @default("free") // free / lite / standard / pro
  planUntil DateTime?
  planPayments PlanPayment[]
  aiUsages     AiUsage[]
  domainReferrals DomainReferral[]
  sellerProfile SellerProfile?

  stripeCustomerId     String? @unique
  stripeSubscriptionId String?
  subscriptionStatus   String? // active / past_due / canceled / null(未加入)

  // 管理者フラグ。/auth/register からは絶対に設定できず、DBを直接操作した場合のみtrueになる。
  // 課金ゲートを素通りできる（テスト用・実際の支払いなしで全機能を確認するため）
  isAdmin Boolean @default(false)

  // スマホアプリのプッシュ通知先（Expo Push Token）。通知オフ・アプリ削除時はnull
  expoPushToken String?

  // trueにすると、AIコンプライアンス担当の審査に通ったSNS投稿下書きを、人間の承認なしで自動的に投稿予約する。
  // 既定はfalse（本人がダッシュボードで明示的にオンにするまで有効にならない）
  autoPublishEnabled Boolean @default(false)

  landingPages        LandingPage[]
  lineConfig          LineConfig?
  socialAccounts      SocialAccount[]
  scheduledPosts      ScheduledPost[]
  agentTasks          AgentTask[]
  automationWorkflows AutomationWorkflow[]
  harnessOrders       HarnessOrder[]
}

// 「どのサイトで、どの操作をするか」を編集できるブラウザ操作の自動化ワークフロー。
// パスワード・カード番号・CVV等を入力する手順は保存・実行のどちらの時点でも拒否する
// （backend/src/automation/safety.ts）。定型的な繰り返し作業（情報収集・フォーム入力の下書きなど）向け。
model AutomationWorkflow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  targetUrl   String
  // [{ action: 'navigate'|'click'|'type'|'select'|'waitFor'|'extract', selector?, value?, label? }, ...]
  steps       Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs AutomationRun[]

  @@index([userId])
}

model AutomationRun {
  id           String             @id @default(cuid())
  workflowId   String
  workflow     AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status       String             @default("running") // running / success / failed / blocked
  // 各手順の実行結果、ブロックされた場合はその理由を記録する
  log          Json?
  blockedStep  Int?
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?

  @@index([workflowId, startedAt])
}

// 役割ごとのAIエージェント（マーケティング担当・成長分析担当など）が定期実行で作った成果物。
// 「作成・分析」は自動で行うが、実際にSNS投稿するなど外部に影響する実行は、
// コンプライアンス担当エージェントの審査を経たうえで、人間の承認（approve）または
// 本人が有効にしたautoPublishEnabledによる自動承認のいずれかを経てから行う
model AgentTask {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      String    // marketing / growth / compliance
  kind      String    // sns_post_draft / lp_health_check
  lpId      String?
  output    Json      // エージェントが作った内容（下書き文章・分析結果など）
  status    String    @default("pending_review") // pending_review / approved / rejected
  // コンプライアンス担当エージェントの審査結果（sns_post_draftのみ）
  reviewPassed Boolean?
  reviewNote   String?
  autoApproved Boolean  @default(false) // trueなら人間の承認を経ず自動で承認・投稿予約された
  createdAt DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId, status])
}

// X / Instagram / YouTube / TikTok の連携。OAuthのアクセストークンを保管する。
// トークンは平文保存（LineConfigと同様、暗号化はフェーズ2で対応）
model SocialAccount {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  platform      String    // x / instagram / youtube / tiktok
  accountLabel  String?   // 表示用（アカウント名・チャンネル名など）
  externalId    String?   // プラットフォーム側のアカウントID
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  connectedAt   DateTime  @default(now())

  @@unique([userId, platform])
}

// 複数プラットフォーム同時投稿の予約。Redis不要のDBポーリング方式（backend/src/social/scheduler.ts）で実行する
model ScheduledPost {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  text        String
  mediaUrl    String?
  platforms   String[] // 例: ["x","instagram"]
  scheduledAt DateTime
  status      String   @default("pending") // pending / processing / done / failed
  attempts    Int      @default(0)
  results     Json?    // { x: {ok:true, postId}, instagram: {ok:false, error} } 形式
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, scheduledAt])
}

model LandingPage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  slug           String   @unique
  businessName   String
  heroTitle      String
  strengths      String[]
  socialProof    String?
  scarcityOffer  String?
  pageViews      Int      @default(0)
  createdAt      DateTime @default(now())

  // lp = 1ページで完結（申し込み・予約への行動に集中）
  // hp = 複数ページ（ホーム＋機能ごとに専用ページ＋ナビゲーション）
  siteType String @default("lp")
  // business = お店・ビジネス / creator = クリエイター活動（音楽・イラスト・写真・動画など）。文言とAIの書き方が変わる
  purpose String @default("business")
  // 持ち主のLINE公式アカウントの友だち追加URL（https://lin.ee/... など）。未登録ならLINEボタンを出さない
  lineAddUrl String?
  // ユーザーが完成例から選んだ土台デザイン（PRESET_METAのid）。未選択ならnull
  templateKey String?

  // 独自ドメイン（例: www.example.jp）。DNSのCNAME確認が取れたらverified=true
  customDomain         String?  @unique
  customDomainVerified Boolean  @default(false)
  // 独自ドメインの公開条件: affiliate = 提携リンクから取得（無料）/ paid = 有料プラン / review = 運営者の確認待ち（猶予期間あり）
  customDomainMode     String?
  customDomainNote     String?
  customDomainReviewUntil DateTime?

  // AIが作成したデザイン（配色・書体・レイアウト）。nullなら業種に合うプリセットを使う
  design          Json?
  designSource    String?   // ai / preset
  designStatus    String?   // generating / ready
  designUpdatedAt DateTime?
  // Geminiが生成したメイン画像（JPEG）。どの公開先でも消えないようDBに保存する
  heroImage       Bytes?
  heroImageType   String?

  // 追加した機能（セクション）。[{ feature, content, inputs, promptBy, updatedAt }]
  // inputs は店主の回答（編集用）で、公開ページには出さない
  sections Json?

  photos   Photo[]
  variants LpVariant[]
  tools    LpTool[]
  likes    PageLike[]
  events   PageEvent[]

  // 通報などで運営者が非公開にしたページ（公開URL・発見・サイトマップのすべてから外れる）
  hidden   Boolean  @default(false)

  // 持ち主が「収益化（PR枠）」をオンにしたページ。PR表示付きで提携サービスの紹介枠を出す
  monetizationEnabled Boolean @default(false)
  // 持ち主が「AIチャットボット」をオンにしたページ。確定した情報だけで訪問者の質問に答える
  chatbotEnabled Boolean @default(false)
  chatbotQuestions ChatbotQuestion[]
  // 予約リクエスト（訪問者が希望日時を送り、持ち主が確定・お断りする）。設定: { menus: [{ name, note }], note, leadDays, maxDays }
  bookingEnabled Boolean @default(false)
  bookingConfig  Json?
  bookings       Booking[]
  products       Product[]
  orders         Order[]

  // 対話で作ったページの「事実の台帳」（AI作成ページビルダー）。項目ごとに出どころ（status）を持つ
  brief    Json?
}

// ---- SNS（フォロー・いいね・閲覧/クリックの記録・通報） ----
model Follow {
  followerId  String
  followingId String
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model PageLike {
  userId    String
  lpId      String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lp        LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, lpId])
  @@index([lpId])
}

// 公開ページの閲覧・クリックの記録（人気・流入元の分析用）。訪問者を特定する情報は保存しない
model PageEvent {
  id        String      @id @default(cuid())
  lpId      String
  lp        LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  type      String      // view / click
  target    String?     // click の行き先の種類（tool / line / sns など）
  source    String?     // 流入元のドメイン（例: instagram.com）。URLのパスやクエリは保存しない
  createdAt DateTime    @default(now())

  @@index([lpId, createdAt])
}

// 違法・有害なページやプロフィールの通報（運営者が確認して非公開にできる）
model Report {
  id         String   @id @default(cuid())
  targetType String   // page / profile
  targetId   String   // page = slug, profile = username
  reason     String   // illegal / scam / adult / harassment / copyright / other
  detail     String?
  reporterId String?
  status     String   @default("open") // open / resolved / dismissed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

// ---- 提携ツール（収益の柱: 運営者のアフィリエイトリンク経由でユーザーが導入する） ----
// 運営者（管理者）が管理画面で登録するツールのカタログ。affiliateUrl はASPで発行された成果測定リンク。
// allowedHosts は、ユーザーが自分のサイトに貼れるURLのホスト（例: airrsv.net）。これ以外のURLは貼らせない
// （任意のURLやHTMLを許すと、AWPドメイン上で第三者のスクリプトが動き、他ユーザーの情報を盗めてしまうため）
model ToolCatalogItem {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  category     String
  description  String
  officialUrl  String
  affiliateUrl String?
  allowedHosts String[]
  // button = ボタンでツールの画面へ移動 / embed = ページ内に埋め込み表示（iframe）も許可
  embeddable   Boolean  @default(false)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  // 利用者のページのPR枠に出して、報酬を利用者と分け合ってよいか。
  // ASP・広告主の規約で「第三者サイトへの掲載・報酬の分配」が認められている案件だけ、運営者がtrueにする
  revenueShareAllowed Boolean @default(false)
  // ドメインの登録サービス（このリンクから取得したドメインは、独自ドメインの公開が無料になる）
  isDomainRegistrar Boolean @default(false)
  // 取得の確認に使う、登録事業者名の一部（RDAPの registrar 名と照合。例: Xserver）
  registrarMatch    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ユーザーが自分のサイトに追加したツール。保存するのは公開用のURLだけで、
// ツールのログイン情報や顧客データはAWPに保存しない（ユーザー本人のツールのアカウント側に残る）
model LpTool {
  id        String      @id @default(cuid())
  lpId      String
  lp        LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  toolKey   String
  label     String
  url       String
  display   String      @default("button") // button / embed
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([lpId])
}

// ---- Harness（L Harness / X Harness / IG Harness）の導入支援 ----
// Harness は AIエージェント株式会社（野田修一 氏）が公開しているOSS（MIT License）。AWPは開発元と提携しておらず、
// 独立した導入支援として「導入（無料）」と、その上に追加する有料機能（ボット導入・投稿/記事の自動作成など）を提供する。
// 料金は運営者が管理画面で決める（priceYen が null のメニューはユーザーに表示しない）
model HarnessAddon {
  id          String   @id @default(cuid())
  key         String   @unique
  harness     String   // line / x / instagram
  name        String
  description String
  priceYen    Int?     // 0 = 無料（導入など）、null = 料金未設定（非表示）
  isInstall   Boolean  @default(false) // そのHarness自体の導入メニュー
  enabled     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ユーザーの申し込み。金額は申し込み時点のメニューをサーバー側で写し取る（画面から送られた金額は使わない）。
// 決済方法は後から追加するため、当面は paymentStatus で「未払い / 支払い不要」だけを管理する
model HarnessOrder {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         Json     // [{ addonId, key, harness, name, priceYen }]
  totalYen      Int
  note          String?
  status        String   @default("requested") // requested / in_progress / done / canceled
  paymentStatus String   @default("unpaid")    // unpaid / not_required / paid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ---- 運営（管理者画面） ----
// システム全体の切り替え（緊急コントロール）。key 例: pause_agent_loop / pause_sns_posting（値は "true" / "false"）
model SystemSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// AIオペレーター（管理者画面のチャット）からの提案。AIは提案を作るだけで、実行は運営者の承認後。
// code_change: 承認するとGitHubに課題（ラベル claude）を作り、Claude Code が隔離環境で実装してプルリクエストを出す。
//              本番への反映は、運営者がプルリクエストをマージしたときだけ（AIが直接本番を変えることはない）
// setting:     承認すると SystemSetting を変更する（例: AIエージェントの一時停止）
model OpsProposal {
  id                String   @id @default(cuid())
  kind              String   // code_change / setting
  title             String
  body              String   // 実装の指示書（code_change）や変更理由
  payload           Json?    // setting の場合 { key, value }
  status            String   @default("awaiting_approval") // awaiting_approval / approved / rejected / failed
  githubIssueNumber Int?
  githubIssueUrl    String?
  error             String?
  createdBy         String
  decidedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// アフィリエイトリンクのクリック計測（どのツールが選ばれているかを把握し、カタログ改善に使う）。
// 個人を特定する情報は保存しない
model AffiliateClick {
  id        String   @id @default(cuid())
  toolKey   String
  // 利用者のページのPR枠から押された場合、そのページ（収益の分配先を確認するため）
  lpId      String?
  source    String?
  createdAt DateTime @default(now())

  @@index([toolKey])
  @@index([lpId])
}

// A/Bテスト用のヒーローコピーのバリエーション。最初の1件を作成した時点で、
// それまでのheroTitleをisControl=trueの行として複製し、以後は登録した行の中から
// 均等な確率で1つを選んで表示する（backend/src/routes/lp.ts の pickVariant）。
// 表示（impressions）・LINE友だち追加への遷移（conversions）を数え、
// 成長分析担当エージェントが十分な件数が集まった時点で優劣を判定する（backend/src/agents/growth.ts）
model LpVariant {
  id          String      @id @default(cuid())
  lpId        String
  lp          LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  label       String
  heroTitle   String
  isControl   Boolean     @default(false)
  enabled     Boolean     @default(true)
  impressions Int         @default(0)
  conversions Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([lpId])
}

// 監視担当エージェントが診断する、想定外のエラーの記録（backend/src/lib/errors.ts で記録、
// backend/src/agents/monitoring.ts でClaudeが原因分析・修正案の提示を行う）。
// 修正コードの自動適用や本番へのロールバックは行わない（human on the loopの原則）。
model SystemError {
  id        String   @id @default(cuid())
  source    String
  message   String
  stack     String?
  context   Json?
  diagnosis String?
  status    String   @default("open") // open / diagnosed / resolved
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// 店主がアップロードした実物の写真とロゴ。Geminiで補正した版（enhanced）はClaudeの審査に通った場合だけ使う
model Photo {
  id            String      @id @default(cuid())
  lpId          String
  lp            LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  isLogo        Boolean     @default(false)
  position      Int         @default(0)
  original      Bytes
  originalType  String
  enhanced      Bytes?
  enhancedType  String?
  enhanceStatus String?     // done / rejected / failed / null(未処理)
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@index([lpId])
}

// channelSecret / channelAccessToken はアプリ層で暗号化してから保存すること
// (フェーズ2で対応。平文保存のままでは他事業者のLINEアカウントの乗っ取りに直結する)
model LineConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  // 無料お試し中はLINEをまだ持っていない顧客もいるため、作成時点では未入力を許可する
  channelId          String?
  channelSecret      String?
  channelAccessToken String?
  // Webhookの自動登録（setupLineWebhook）を既に実行済みか。有料プラン加入時に一度だけ実行する
  webhookActivated   Boolean  @default(false)
  friendsAdded       Int      @default(0)
  createdAt          DateTime @default(now())
}

// AWP自体の見た目（マーケティングLP・ウィザードなどの装飾画像）。
// 顧客のLPとは無関係。管理者が管理画面からAIで生成・差し替えできる（キー単位で1枚だけ保持）
model SiteAsset {
  key       String   @id
  image     Bytes
  mimeType  String
  prompt    String
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  tenantId  String
  senderName String
  message   String
  source    String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ---- 対話で作るページビルダー ----
// AIが聞き取りをしながら、事実を項目ごとに整理する。各項目の status:
//   provided   = 本人が会話の中で伝えた
//   confirmed  = 本人が確認画面で「確定」した
//   assumed    = AIの推測（本人の確定が必要）
//   default    = システムの既定値
//   unconfirmed = まだわからない
// 公開に使うのは confirmed と default だけ（本人が確定していない事実は公開しない）
model BuilderSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Json     // [{ role: user|assistant, content }]
  brief     Json     // { purpose, facts: [{ key, value, status }], copy: { heroTitle, strengths, status }, suggestedSlug }
  status    String   @default("active") // active / published
  lpId      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---- 収益の分配と台帳（複式簿記） ----
// お金の動きはすべて取引（LedgerTransaction）として記録し、各取引の借方合計＝貸方合計になるようにする。
// 勘定科目（account）:
//   platform:receivable   … ASP・広告主から受け取る予定の報酬（資産）
//   platform:revenue      … AWPの取り分（収益）
//   platform:sales        … キャッシュで支払われたAWPの有料機能の売上（収益）
//   user:<userId>:cash    … 利用者に分配したキャッシュ（AWPから見た負債。残高 = 貸方 - 借方）
// 記録した取引は書き換えない。誤りは逆仕訳（reversal）で取り消す
model LedgerTransaction {
  id        String        @id @default(cuid())
  kind      String        // revenue_share / harness_payment / reversal
  memo      String
  refType   String?       // revenue_event / harness_order
  refId     String?
  createdBy String?
  createdAt DateTime      @default(now())
  entries   LedgerEntry[]

  @@index([refType, refId])
}

model LedgerEntry {
  id        String            @id @default(cuid())
  txId      String
  tx        LedgerTransaction @relation(fields: [txId], references: [id], onDelete: Restrict)
  account   String
  userId    String?           // user:<id>:cash の場合の利用者ID（残高集計用）
  debit     Int               @default(0)
  credit    Int               @default(0)
  createdAt DateTime          @default(now())

  @@index([account])
  @@index([userId])
}

// ASP・広告主の管理画面で「確定」した報酬を、運営者が記録したもの。記録時に 78%（ページの持ち主）/ 22%（AWP）で分配する
model RevenueEvent {
  id          String   @id @default(cuid())
  toolKey     String
  lpId        String?
  userId      String?  // 分配先（ページの持ち主）。ページなし（AWP自身の紹介）の場合はnull
  grossYen    Int
  ownerYen    Int
  platformYen Int
  occurredOn  DateTime
  externalRef String?  // ASP側の成果ID（二重記録の防止）
  note        String?
  status      String   @default("recorded") // recorded / reversed
  txId        String
  createdBy   String
  createdAt   DateTime @default(now())

  @@unique([toolKey, externalRef])
  @@index([userId])
}

// ページのAIチャットボットに届いた質問（持ち主が「よく聞かれること」を知るため）。
// 回答文や訪問者の情報は保存しない。90日を過ぎたものは自動で削除する
model ChatbotQuestion {
  id        String      @id @default(cuid())
  lpId      String
  lp        LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  question  String
  answered  Boolean     // AIがページの情報から答えられたか（false = 情報が足りなかった）
  createdAt DateTime    @default(now())

  @@index([lpId, createdAt])
}

// ---- 予約リクエスト ----
// 訪問者の連絡先を扱うため、保存するのは予約のやり取りに必要な最小限だけ。希望日から1年過ぎたものは自動で削除する
model Booking {
  id          String      @id @default(cuid())
  lpId        String
  lp          LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  code        String      @unique // 訪問者が状況を確認するための番号（推測されにくいランダム文字列）
  menu        String?
  requestedAt DateTime    // 希望日時
  name        String
  contact     String      // メールアドレスまたは電話番号
  message     String?
  status      String      @default("requested") // requested / confirmed / declined / canceled
  ownerNote   String?     // 持ち主から訪問者への一言（状況確認ページに表示）
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([lpId, requestedAt])
}

// ---- 商品（ページに並べる商品カタログ） ----
// 購入は持ち主が使っているネットショップ（BASE・STORES など）で行う。AWPは代金を預からない
model Product {
  id          String      @id @default(cuid())
  lpId        String
  lp          LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  name        String
  priceYen    Int?        // 持ち主が入力した価格（未入力なら価格を出さない）
  priceNote   String?     // 例: 税込 / 送料別
  description String?
  image       Bytes?
  imageType   String?
  buyUrl      String?     // 許可したネットショップのhttps URLのみ
  soldOut     Boolean     @default(false)
  // AWPで注文を受け付けるか（出品者の設定と特商法の表示がそろっている場合のみ）
  purchasable Boolean     @default(false)
  stock       Int?        // 在庫（null = 数を管理しない）
  requiresShipping Boolean @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([lpId])
}

// ---- 投稿（プロフィールとフォロワーのタイムラインに出る短い投稿） ----
model Post {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  image     Bytes?
  imageType String?
  hidden    Boolean  @default(false) // 通報で運営者が非公開にした投稿
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---- 利用者自身の X Harness / IG Harness との接続 ----
// 利用者が自分のCloudflareに導入したHarnessのURLとAPIキー（暗号化して保存）。
// AWPはここから、利用者が承認した投稿だけを予約する（投稿の実行は利用者のHarnessが行う）
model HarnessLink {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String   // x / instagram
  baseUrl      String   // https://〇〇.workers.dev
  apiKeyEnc    String   // AES-256-GCM で暗号化したAPIキー
  accountId    String?  // Harness側のアカウントID
  accountLabel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, kind])
}

model HarnessScheduledPost {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String   // x / instagram
  text        String
  scheduledAt DateTime
  remoteId    String?  // Harness側の予約ID
  status      String   @default("scheduled") // scheduled / canceled / failed
  error       String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ---- ローンチ・クルー（Discordで動く開発チームのエージェント） ----
// 公開までのタスク・1日の15分刻みの予定・状態を持つ。実装はGitHubの課題→Claude Code→PR→運営者のマージで行う
model CrewTask {
  key          String    @id // 例: T01（あなたの作業）/ A01（エージェントの作業）/ B01（不具合）
  title        String
  area         String    // setup / legal / dev / qa / content / ops / launch
  epic         String    // スクワッド（Discordのスレッド）単位のまとまり
  owner        String    // user / agent
  agents       String[]  // 担当ペルソナ（mina / sora / kei / tetsu / ritsu / haru）
  estimateMin  Int
  remainingMin Int
  priority     Int       @default(2) // 0 が最優先
  planDay      String    // 目標日 YYYY-MM-DD（JST）
  dueDay       String?
  dependsOn    String[]
  status       String    @default("todo") // todo / doing / waiting / blocked / review / done / skipped
  steps        String?   // あなたの作業の手順
  acceptance   String    // 完了の条件
  notes        String?   // 完了時のメモなど（後続タスクに引き継ぐ）
  issueNumber  Int?
  issueUrl     String?
  branch       String?
  prNumber     Int?
  prUrl        String?
  reviewState  String?   // requested / passed / attention
  reviewRequestedAt DateTime?
  dispatchedAt DateTime?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, planDay])
}

model CrewDayPlan {
  day        String    @id // YYYY-MM-DD（JST）
  blocks     Json      // [{ start, end, kind, taskKey?, title }]
  postedAt   DateTime?
  reportedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// チャンネルID・Webhook（暗号化）・最後に処理した時刻など
model CrewState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CrewLog {
  id        String   @id @default(cuid())
  agent     String
  kind      String
  taskKey   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---- 有料プランの支払い（自前の請求。決済会社を通さない） ----
model PlanPayment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String    // lite / standard / pro
  months      Int
  amountYen   Int
  method      String    // bank / cash
  reference   String    @unique // 振込の名義に付けてもらう番号
  status      String    @default("pending") // pending / confirmed / canceled / expired
  expiresAt   DateTime? // 振込の期限
  confirmedAt DateTime?
  confirmedBy String?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

// AIの利用記録（プランごとの月のAI利用枠の計算に使う。料金は公開価格からの見積もり）
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ドメインの登録サービスへの提携リンクを、ログイン中の本人が押した記録（無料の独自ドメインの判定に使う）
model DomainReferral {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolKey   String
  clickedAt DateTime @default(now())

  @@index([userId, clickedAt])
}

// ---- 直接払いのショップ（AWPは代金を預からない。購入者は出品者に直接支払う） ----
model SellerProfile {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  // 特定商取引法に基づく表記（出品者ごと）: { sellerName, responsible, address, phone, email, priceNote, extraFees, deliveryTime, returns, paymentNote, disclosureOnRequest }
  legal          Json
  bankEnc        String?  // 振込先（暗号化）: { bank, branch, type, number, holder }
  bankEnabled    Boolean  @default(false)
  inPersonEnabled Boolean @default(false)  // 店頭・手渡しでの支払い
  inPersonNote   String?
  shippingFeeYen Int      @default(0)
  freeShippingOverYen Int?
  paymentDays    Int      @default(7)      // 振込の期限（日）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // 購入者が状況を確認する番号（推測されにくいランダム文字列）
  lpId          String
  lp            LandingPage @relation(fields: [lpId], references: [id], onDelete: Cascade)
  sellerId      String
  items         Json        // [{ productId, name, priceYen, qty }]
  subtotalYen   Int
  shippingYen   Int
  totalYen      Int
  paymentMethod String      // bank / in_person
  buyerName     String
  buyerContact  String
  shipping      Json?       // { postal, address, name }
  message       String?
  status        String      @default("awaiting_payment") // awaiting_payment / paid / shipped / completed / canceled
  expiresAt     DateTime?
  paidAt        DateTime?
  shippedAt     DateTime?
  sellerNote    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sellerId, createdAt])
  @@index([status, expiresAt])
}

// ---- AI企業（AIエージェントによる自律運営） ----
// 人間が目標（CompanyGoal）を設定 → CEOが分析し COO に委任 → COO がタスク（CompanyTask）に分解して専門エージェントへ →
// 各エージェントが道具（Hands）で実行 → 監査役（Auditor）が実際のシステム状態で検証 → CEO へ報告、のサイクル。
// エージェント同士は直接会話せず、必ずタスク・イベント・メモリを介してやり取りする（誰が・いつ・何を・なぜ、を追跡できるように）
model CompanyGoal {
  id          String   @id @default(cuid())
  title       String
  description String
  kpis        Json     // [{ key, label, target, unit, by }]
  status      String   @default("active") // active / paused / achieved / dropped
  setBy       String   // 人間（運営者）のID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       CompanyTask[]
}

model CompanyTask {
  id            String    @id @default(cuid())
  goalId        String?
  goal          CompanyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  parentId      String?
  title         String
  instructions  String
  assignee      String    // エージェントのキー（registry.ts）
  createdBy     String    // エージェントのキー または human
  risk          String    @default("low") // low / medium / high
  status        String    @default("queued") // queued / running / awaiting_approval / verifying / done / failed / rejected / canceled
  runAt         DateTime  @default(now())
  attempts      Int       @default(0)
  result        Json?     // { summary, facts, assumptions, artifacts, nextActions }
  verification  Json?     // 監査役の判定 { passed, findings, checkedAt }
  error         String?
  costUsd       Float     @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  actions       CompanyAction[]
  runs          AgentRun[]

  @@index([status, runAt])
  @@index([assignee, createdAt])
  @@index([parentId])
}

// 人間の承認が必要な操作（高リスクの道具の呼び出し）。承認されると実行され、結果はタスクに戻る
model CompanyAction {
  id         String      @id @default(cuid())
  taskId     String
  task       CompanyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent      String
  tool       String
  input      Json
  reason     String
  risk       String
  status     String      @default("pending") // pending / approved / rejected / executed / failed
  result     Json?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([status, createdAt])
}

model CompanyEvent {
  id        String   @id @default(cuid())
  type      String   // task.created / task.done / action.requested / memory.written / cycle.ceo など
  actor     String
  taskId    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// スコープ付きのメモリ。company（全社）/ dept:<部門> / agent:<キー> / project:<id>。
// エージェントは registry.ts で許可されたスコープだけ読み書きできる
model CompanyMemory {
  id        String   @id @default(cuid())
  scope     String
  key       String
  content   String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([scope])
}

model AgentRun {
  id           String      @id @default(cuid())
  agent        String
  taskId       String?
  task         CompanyTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  model        String
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  costUsd      Float       @default(0)
  toolCalls    Int         @default(0)
  status       String      // ok / error / budget
  error        String?
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?

  @@index([agent, startedAt])
}

// エージェントごとの運用設定（コード上の定義を上書きする分だけ）
model CompanyAgentConfig {
  key            String  @id
  enabled        Boolean @default(true)
  model          String?
  dailyBudgetUsd Float?
  updatedAt      DateTime @updatedAt
}

// 運営者とエージェントの会話（管理画面のチャット）。会話の中でもエージェントは道具を使って実行する
model CompanyChat {
  id        String   @id @default(cuid())
  agent     String
  title     String
  messages  Json     // [{ role, content, tools?: string[], actions?: [{id, tool, reason}] }]
  taskId    String?  // 会話の中で作った操作・タスクの親になる CompanyTask
  costUsd   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
