# このファイルを .env にコピーして、実際の値を入力してください。
# .env はコミットしないこと。

# PostgreSQLの接続文字列（Supabase / Railway / Renderなどで無料枠あり）
DATABASE_URL="postgresql://user:password@localhost:5432/webline_sync"

# JWTの署名に使う秘密鍵。16文字以上のランダムな文字列にすること。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ここに長いランダム文字列を入れる"

PORT=8000

# このサーバーが外部から到達できるURL（LINEのWebhook自動設定、SNS連携のOAuthコールバックに使用）
# 開発中は ngrok 等で発行した https URL を、本番ではデプロイ先のURLを入れる。
# SNS連携を使う場合、各プラットフォームの開発者アプリに
# {PUBLIC_BASE_URL}/api/social/{platform}/callback をリダイレクトURIとして登録すること
PUBLIC_BASE_URL="https://your-domain.example.com"

# AI（組み合わせてページを作る）
#  - Claude: 文章・配色やレイアウトの決定・画像の品質審査（console.anthropic.com で取得）
#  - メイン画像の生成: 以下のどちらかを設定（両方設定した場合はCloudflareを優先。無料枠が大きいため）
#    - Cloudflare Workers AI: 1日10,000 Neuronsまで無料（dash.cloudflare.com の Workers AI から取得）
#    - Gemini: aistudio.google.com で取得。無料枠だと画像生成は1日0回になることが多い
#  どれも未設定・失敗でも、業種に合うプリセットのデザインで公開される（画像なし）
#  - CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN は、AIエージェント（backend/src/agents）による
#    プラットフォーム別SNS投稿文の下書き作成にも使う（Qwen3。高頻度実行でも無料枠内で運用できるため）
ANTHROPIC_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
GEMINI_API_KEY=""
# 任意: APIキーがワークスペースに紐づいていない場合に必要（Console → 組織の設定 → ワークスペース の ID。wrkspc_...）
ANTHROPIC_WORKSPACE_ID=""
# 任意: モデルを変える場合のみ（既定: claude-opus-5 / gemini-3.1-flash-image）
# CLAUDE_MODEL="claude-opus-5"
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# 独自ドメイン誘導（アフィリエイト）用。あなたの提携IDを入れると、
# ダッシュボードの「独自ドメインを使いたい方へ」に反映される。空欄なら非表示。
# アフィリエイト（Xserver／A8.net経由）
# A8.netの管理画面で発行される「成果測定リンク」(px.a8.net/... の形式) を丸ごと貼り付ける。
# 承認前は空欄のままにしておくと、ボタン自体が表示されない。
AFF_XSERVER_DOMAIN_URL=""   # XServerドメイン（独自ドメイン取得用。1件1,000円 ※2027/1/12までのキャンペーン）
AFF_XSERVER_URL=""          # エックスサーバー（自前のHP/WordPressも持ちたい顧客向け。1件5,000円〜）

# 独自ドメインの接続先。顧客にはDNSで「CNAME → この値」を設定してもらう。
# 本番のデプロイ先で決まる値（例: lp.weblinesync.jp）
CUSTOM_DOMAIN_CNAME_TARGET=""

# 検索エンジンへの即時通知（IndexNow）。SITE_URLはフロントエンドの.envと同じ値にすること。
# INDEXNOW_KEYは生成後、frontend/public/{このキー}.txt というファイルを作り、中身に同じキーを書くこと
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_URL="http://localhost:3000"
INDEXNOW_KEY=""

# SMS認証（新規登録時の電話番号確認・パスワード再設定）。Twilio Verify を使う。
# Twilioコンソールで Account SID / Auth Token と、Verify の Service SID（VA...）を取得する。
# 3つとも設定されていればSMS認証が有効になる（未設定なら電話番号なしで登録でき、パスワード再設定は使えない）
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# サービス全体で1時間に送るSMSの上限（不正な大量送信で請求額が膨らむのを防ぐ）
SMS_GLOBAL_HOURLY_LIMIT="200"
# 手元の開発専用: SMSを送らず確認コードをサーバーのログに出す。本番では絶対に設定しないこと
SMS_DEV_MODE=""

# 管理者画面のAIオペレーター → 承認したコード変更をGitHubの課題として登録（.github/workflows/claude.yml の Claude Code が実装）
# GITHUB_OPS_TOKEN: このリポジトリだけに限定した fine-grained token（Issues: Read and write）
GITHUB_OPS_TOKEN=""
GITHUB_REPO="prophet-miyabi/Actualize-World-Peace"

# 利用者から預かる外部サービスの鍵（X/IG HarnessのAPIキー）を暗号化する鍵（64桁の16進数）。
# 未設定なら JWT_SECRET から導出する。設定する場合は、最初の利用者が接続する前に決めて以後変えないこと（変えると復号できなくなる）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=""

# ローンチ・クルー（Discordで動く開発チームのエージェント）。管理画面「ローンチ・クルー」から初期設定する
# Discord開発者ポータルで作ったアプリの値。Interactions Endpoint URL は {PUBLIC_BASE_URL}/api/crew/discord/interactions
DISCORD_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_GUILD_ID=""
# 操作できるのを運営者だけにする（あなたのDiscordユーザーID）
DISCORD_OWNER_ID=""
# 任意: 作業時間（既定 10:00〜19:00）・同時に進めるエージェントのタスク数（既定 2）・/ask の月の上限（ドル、既定 5）
# CREW_DAY_START="10:00"
# CREW_DAY_END="19:00"
# CREW_WIP_LIMIT="2"
# CREW_ASK_MONTHLY_USD="5"

# AI企業（CEO以下のエージェントの自律運営）。ANTHROPIC_API_KEY を使う（APIの従量課金。Claude Max プランとは別）
# 任意: モデル（強い/速い）・同時実行数・CEOの日次見直しの時刻（JST）・ウェブ検索の無効化
# COMPANY_MODEL_STRONG="claude-opus-5"
# COMPANY_MODEL_FAST="claude-haiku-4-5-20251001"
# COMPANY_CONCURRENCY="2"
# COMPANY_CEO_HOUR="8"
# COMPANY_WEB_SEARCH="true"
# 会社のエージェント全体の月のAI費用の上限（米ドル、既定150）。Max 20x の月間APIクレジット$200のうち、利用者向けAIの分を残すため
# COMPANY_MONTHLY_CAP_USD="150"

# 課金（Stripe）。ダッシュボード(dashboard.stripe.com)で取得。
# STRIPE_SECRET_KEY: 開発中はテストモードの sk_test_... を使うこと
# STRIPE_PRICE_ID: 月額サブスクの商品を作成した際に発行される price_...
# STRIPE_WEBHOOK_SECRET: Webhookエンドポイント作成時に発行される whsec_...
# SNS連携（X / Instagram / Facebook / YouTube / TikTok）。開発者アプリを登録していないプラットフォームは
# 空欄のままでよい（ダッシュボードに「準備中」と表示され、機能自体は他が動く）。
# Instagram Business連携済みならFacebookは同じMetaアプリを使い回せる（Facebookログインの追加のみでよい）
X_CLIENT_ID=""
X_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
FRONTEND_URL="http://localhost:3000"

# 管理者用の自動ログインリンク（テスト専用）。
# 有効にする場合は両方を設定する。本番環境では絶対に設定しないこと。
ENABLE_DEV_LOGIN=""
DEV_LOGIN_CODE=""
