# このファイルを .env.local にコピーしてください。
# 画面は同じURLの /api を使い、Next.js がバックエンドへ中継する（通常は変更不要）
# バックエンドの場所（中継先・サーバー内部からの呼び出し先）
API_ORIGIN=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000/api

# このサービス自身のドメイン（カンマ区切り）。これ以外のドメインでアクセスされたら
# 顧客の独自ドメインとみなして、そのLPを表示する。本番例: weblinesync.jp,www.weblinesync.jp
MAIN_HOSTS=localhost,127.0.0.1

# AWP自身が所有するドメイン（サブドメインなし。例: awp.jp）。設定すると、
# {事業者のURL}.awp.jp のようなサブドメインで直接そのLPにアクセスできるようになる。
# 前提条件（DNS側の設定）:
#   1. ルートドメイン（awp.jp）自体もRenderの当該WebサービスへCNAME/Aで向いていること
#   2. "*" のCNAMEレコードを、Renderが指定するonrender.comのホスト名へ向ける
#   3. "_acme-challenge" と "_cf-custom-hostname" のCNAMEレコードを、
#      Renderダッシュボードの「ワイルドカードカスタムドメイン追加」画面が表示する値へ向ける
#   4. Renderダッシュボードで「Verify」を押して検証を完了する
# 未設定のままなら、この機能自体が無効になるだけで、既存の /{slug} 形式のアクセスには影響しない
MAIN_DOMAIN=

# SEO: サイトマップ（/sitemap.xml）・robots.txtに載せる、このサービス自身の正しいURL。
# 本番デプロイ時は実際の公開URLに変更すること（例: https://weblinesync.jp）
SITE_URL=http://localhost:3000
