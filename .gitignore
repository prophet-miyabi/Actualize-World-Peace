.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# ビルド成果物
.next/
dist/
build/

# Expo / モバイル
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ログ・OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Prisma
backend/prisma/*.db
mobile/

# 進捗報告エージェントが生成するレポート（実行のたびに再生成されるため）
backend/reports/

# TypeScriptの増分ビルドキャッシュ
*.tsbuildinfo

# 受託ドキュメント・財務諸表の生成物（顧客情報を含むため）
contracts/output/
finance/output/

# Auto-Sales-Agent: 案件文（個人情報を含みうる）・生成物は入れない。サンプルだけ残す
auto-sales-agent/input/*
!auto-sales-agent/input/sample-reform/
!auto-sales-agent/input/sample-ai-asset/
!auto-sales-agent/input/miyabi-tech/
auto-sales-agent/dist/
